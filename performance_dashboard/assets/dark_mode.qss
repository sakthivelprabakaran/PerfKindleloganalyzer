/* A simple, clean dark mode stylesheet */
QWidget {
    background-color: #2B2B2B;
    color: #EAEAEA;
    font-family: Arial, sans-serif;
}

QGroupBox {
    border: 1px solid #555;
    border-radius: 5px;
    margin-top: 10px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
}

QPushButton {
    background-color: #007BFF;
    color: white;
    border-radius: 4px;
    padding: 8px 12px;
    border: none;
}

QPushButton:hover {
    background-color: #0056b3;
}

QLineEdit, QTextEdit, QComboBox {
    border: 1px solid #555;
    border-radius: 4px;
    padding: 5px;
    background-color: #3C3C3C;
    color: #EAEAEA;
}

QTableWidget {
    border: 1px solid #555;
    gridline-color: #444;
}

QHeaderView::section {
    background-color: #3C3C3C;
    padding: 4px;
    border: 1px solid #555;
    font-weight: bold;
}

QTabWidget::pane {
    border-top: 1px solid #555;
}

QTabBar::tab {
    background: #3C3C3C;
    border: 1px solid #555;
    padding: 8px;
    border-bottom: none;
}

QTabBar::tab:selected {
    background: #2B2B2B;
    margin-bottom: -1px;
}